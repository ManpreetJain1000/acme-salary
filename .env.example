# API (apps/api). Development works with no .env at all; production requires the
# two marked values and refuses to start without them.
PORT=4000
DATABASE_PATH=./data/acme.db
CORS_ORIGIN=http://localhost:3000
SEED_ON_BOOT=true
RATE_LIMIT_PER_MINUTE=600

# Sign-in
HR_EMAIL=hr@acme.example
HR_PASSWORD=change-me-please        # required in production (12+ characters)
SESSION_SECRET=                     # required in production (32+ characters), e.g. openssl rand -hex 32
COOKIE_SECURE=                      # defaults to true in production; false only for plain-HTTP local runs
DEMO_LOGIN_HINT=                    # defaults to true in development; shows the demo sign-in on /login

# Backups (npm run backup)
BACKUP_DIR=./backups
BACKUP_KEEP=14

# Web (apps/web)
API_URL=http://localhost:4000
